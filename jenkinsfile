pipeline {
    environment {
        MY_APP_PATH = "/usr/local/myapp/bin"
        }
    parameters {
    string(name: 'BRANCH', defaultValue: 'main', description: '빌드할 git branch')
    }
    agent any
    stages {
    stage('Checkout') {
      steps {
        echo "Building branch: ${params.BRANCH}"
      }
    }
    stage('Build') {
      steps {
        sh 'echo $MY_APP_PATH'
        sh 'chmod +x ./build.sh'
        sh './build.sh'
      }
    }
    stage('Test') {
      steps {
        sh 'echo "Simulating test command"'
      }
    }
  }
}